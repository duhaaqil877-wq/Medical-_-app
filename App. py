# ---------------------------------------------------------
# 3. دالة فحص النتائج مقارنة بالنطاق المرجعي
# ---------------------------------------------------------
def analyze_test_result(user_val, min_val, max_val):
    try:
        val = float(user_val)
        if val < min_val:
            return "منخفض ⬇️", "Low", "#D32F2F"
        elif val > max_val:
            return "مرتفع ⬆️", "High", "#D32F2F"
        else:
            return "طبيعي ✅", "Normal", "#2E7D32"
    except ValueError:
        return "غير معروف", "Unknown", "#757575"

# ---------------------------------------------------------
# 4. دالة إنشاء تقرير الـ PDF
# ---------------------------------------------------------
def generate_pdf(patient_name, patient_age, patient_gender, test_results, notes):
    buffer = io.BytesIO()
    doc = SimpleDocTemplate(
        buffer,
        pagesize=letter,
        rightMargin=36,
        leftMargin=36,
        topMargin=36,
        bottomMargin=36
    )
    story = []
    styles = getSampleStyleSheet()

    title_style = ParagraphStyle('TitleStyle', parent=styles['Heading1'], fontSize=18, textColor=colors.HexColor('#1A365D'), alignment=1, spaceAfter=10)
    subtitle_style = ParagraphStyle('SubTitle', parent=styles['Normal'], fontSize=10, textColor=colors.HexColor('#4A5568'), alignment=1, spaceAfter=15)
    meta_style = ParagraphStyle('MetaStyle', parent=styles['Normal'], fontSize=10, textColor=colors.HexColor('#2D3748'), leading=14)
    table_header_style = ParagraphStyle('TableHeader', parent=styles['Normal'], fontSize=10, textColor=colors.white, alignment=1)
    table_cell_style = ParagraphStyle('TableCell', parent=styles['Normal'], fontSize=9, textColor=colors.HexColor('#2D3748'), alignment=1)

    story.append(Paragraph("<b>CLINICAL DECISION SUPPORT SYSTEM</b>", title_style))
    story.append(Paragraph("Patient Lab Analysis & Medical Assessment Report", subtitle_style))
    story.append(HRFlowable(width="100%", thickness=1.5, color=colors.HexColor('#2B6CB0'), spaceAfter=15))

    meta_data = [
        [
            Paragraph(f"<b>Patient Name:</b> {patient_name}", meta_style),
            Paragraph(f"<b>Date:</b> {datetime.now().strftime('%Y-%m-%d %H:%M')}", meta_style)
        ],
        [
            Paragraph(f"<b>Age / Gender:</b> {patient_age} yrs / {patient_gender}", meta_style),
            Paragraph(f"<b>Report ID:</b> CDSS-{datetime.now().strftime('%M%S')}", meta_style)
        ]
    ]
    meta_table = Table(meta_data, colWidths=[270, 270])
    meta_table.setStyle(TableStyle([
        ('BACKGROUND', (0, 0), (-1, -1), colors.HexColor('#F7FAFC')),
        ('PADDING', (0, 0), (-1, -1), 8),
        ('BOX', (0, 0), (-1, -1), 0.5, colors.HexColor('#E2E8F0')),
    ]))
    story.append(meta_table)
    story.append(Spacer(1, 15))

    story.append(Paragraph("<b>Laboratory Test Results</b>", ParagraphStyle('Sub', parent=styles['Heading2'], fontSize=12, textColor=colors.HexColor('#2B6CB0'), spaceAfter=8)))
    
    table_data = [
        [
            Paragraph("<b>Test Name</b>", table_header_style),
            Paragraph("<b>Result</b>", table_header_style),
            Paragraph("<b>Unit</b>", table_header_style),
            Paragraph("<b>Reference Range</b>", table_header_style),
            Paragraph("<b>Status</b>", table_header_style)
        ]
    ]

    for item in test_results:
        status_color = "#C53030" if item['status_en'] in ['Low', 'High'] else "#2F855A"
        status_p = Paragraph(f"<font color='{status_color}'><b>{item['status_en']}</b></font>", table_cell_style)
        
        table_data.append([
            Paragraph(item['test'], table_cell_style),
            Paragraph(str(item['value']), table_cell_style),
            Paragraph(item['unit'], table_cell_style),
            Paragraph(item['range'], table_cell_style),
            status_p
        ])

    results_table = Table(table_data, colWidths=[160, 80, 80, 110, 110])
    results_table.setStyle(TableStyle([
        ('BACKGROUND', (0, 0), (-1, 0), colors.HexColor('#2B6CB0')),
        ('ALIGN', (0, 0), (-1, -1), 'CENTER'),
        ('VALIGN', (0, 0), (-1, -1), 'MIDDLE'),
        ('GRID', (0, 0), (-1, -1), 0.5, colors.HexColor('#CBD5E0')),
        ('ROWBACKGROUNDS', (0, 1), (-1, -1), [colors.white, colors.HexColor('#F7FAFC')]),
        ('PADDING', (0, 0), (-1, -1), 6),
    ]))
    story.append(results_table)
    story.append(Spacer(1, 15))

    if notes:
        story.append(Paragraph("<b>Clinical Observations & Decision Support</b>", ParagraphStyle('Sub2', parent=styles['Heading2'], fontSize=12, textColor=colors.HexColor('#2B6CB0'), spaceAfter=8)))
        notes_p = Paragraph(notes.replace('\n', '<br/>'), ParagraphStyle('Notes', parent=styles['Normal'], fontSize=9, leading=13, textColor=colors.HexColor('#2D3748')))
        notes_table = Table([[notes_p]], colWidths=[540])
        notes_table.setStyle(TableStyle([
            ('BACKGROUND', (0, 0), (-1, -1), colors.HexColor('#EDF2F7')),
            ('PADDING', (0, 0), (-1, -1), 10),
            ('BOX', (0, 0), (-1, -1), 0.5, colors.HexColor('#CBD5E0')),
        ]))
        story.append(notes_table)

    doc.build(story)
    buffer.seek(0)
    return buffer

# ---------------------------------------------------------
# 5. واجهة المستخدم والتفاعل
# ---------------------------------------------------------
st.title("🩺 نظام دعم القرار الطبي وااختبارات التحاليل")
st.markdown("قم بملء البيانات الطبية أدناه للحصول على تحليل فوري وتوليد تقرير طبي احترافي.")

st.sidebar.header("📋 بيانات المريض")
patient_name = st.sidebar.text_input("اسم المريض", "أحمد محمد")
patient_age = st.sidebar.number_input("العمر", min_value=1, max_value=120, value=35)
patient_gender = st.sidebar.selectbox("الجنس", ["Male", "Female"])
clinical_notes = st.sidebar.text_area("ملاحظات سريرية أو تشخيص مبدئي", "المريض يعاني من إجهاد عام مع صداع خفيف.")

st.subheader("🧪 إدخال نتائج التحاليل الطبية")

patient_results = []

tabs = st.tabs(list(LAB_TESTS_DB.keys()))

for tab, (category_name, tests) in zip(tabs, LAB_TESTS_DB.items()):
    with tab:
        st.markdown(f"#### قائمة {category_name}")
        cols = st.columns(2)
        
        for idx, (test_name, details) in enumerate(tests.items()):
            col = cols[idx % 2]
            with col:
                val = st.text_input(
                    f"{test_name} ({details['unit']})",
                    placeholder=f"المعدل الطبيعي: {details['min']} - {details['max']}",
                    key=test_name
                )
                
                if val:
                    status_ar, status_en, color_code = analyze_test_result(
                        val, details['min'], details['max']
                    )
                    st.markdown(f"<span style='color:{color_code}; font-weight:bold;'>الحالة: {status_ar}</span> (النطاق: {details['min']} - {details['max']})", unsafe_allow_html=True)
                    
                    patient_results.append({
                        "test": test_name,
                        "value": val,
                        "unit": details['unit'],
                        "range": f"{details['min']} - {details['max']}",
                        "status_ar": status_ar,
                        "status_en": status_en
                    })

st.markdown("---")

if st.button("📄 إنشاء التقرير الطبي وتصدير PDF", type="primary"):
    if patient_results:
        pdf_buffer = generate_pdf(patient_name, patient_age, patient_gender, patient_results, clinical_notes)
        
        st.success("تم تحليل النتائج وإنشاء التقرير بنجاح!")
        
        st.download_button(
            label="⬇️ تحميل التقرير (PDF)",
            data=pdf_buffer,
            file_name=f"Medical_Report_{patient_name}.pdf",
            mime="application/pdf"
        )
    else:
        st.warning("يرجى إدخال قيمة تحليل واحد على الأقل قبل تصدير التقرير.")
